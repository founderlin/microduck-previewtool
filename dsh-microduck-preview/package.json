{
  "name": "@local/dsh-microduck-preview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Microduck action workbench for DSH: timelines, real MuJoCo preview, task-bound reward recipes, explanation clips and BAM review packs.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "pipeline/*.py",
    "pipeline/README.md",
    "README.md",
    "assets/*",
    "rewards/*.json",
    "pipeline/ready.json"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:frames": "MICRODUCK_FRAME_INTEGRATION=1 node test/frames.test.mjs"
  }
}
