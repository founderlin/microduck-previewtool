{
  "name": "@local/dsh-microduck-preview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Microduck gait motion preview for DeepSeek Harness: two agent tools (duck_templates, duck_preview) that run a MuJoCo pipeline in the background, plus a Web viewer panel that streams the resulting mp4.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "pipeline/*.py",
    "pipeline/README.md",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
